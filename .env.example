# ---- Public (VITE_ vars are baked into the client bundle at build time) ----
# Discord application OAuth2 Client ID (https://discord.com/developers/applications).
# Leave empty to run purely standalone (no Discord integration in the UI).
VITE_DISCORD_CLIENT_ID=

# ---- Server secrets (consumed by Express; docker-compose loads this file) ----
# Port the Express server listens on (also exposed by the Docker image)
PORT=3000

# OAuth2 client secret — required for /api/token when VITE_DISCORD_CLIENT_ID is set.
DISCORD_CLIENT_SECRET=

# Optional: bot token to verify activity instances server-side
# (GET /applications/:app_id/activity-instances/:instance_id)
DISCORD_BOT_TOKEN=

# Set automatically inside the Docker image — do NOT set it here.
# When absent, the server loads this file via dotenv.
IS_DOCKER=
